# OpenCode Gemini Account optional environment overrides.
# None of these are required for the default "Sign in with Google" flow.

# Let the auto flow fall back to the experimental Antigravity backend (0 or 1).
OPENCODE_GOOGLE_EXPERIMENTAL_ANTIGRAVITY=0

# Default backend for CLI and manual flows: auto, code-assist, or antigravity.
OPENCODE_GOOGLE_PROFILE=auto

# Google Cloud project ID for Workspace, Code Assist Standard, and Code Assist Enterprise.
# GOOGLE_CLOUD_PROJECT=my-project-123

# Path to a local OAuth client file. Defaults to oauth-clients.json in the package root.
# OPENCODE_GOOGLE_CLIENTS_FILE=

# Bring your own registered desktop-app OAuth client (optional).
# OPENCODE_GOOGLE_CLIENT_ID=
# OPENCODE_GOOGLE_CLIENT_SECRET=

# Separate client for minting Antigravity-profile tokens (optional).
# OPENCODE_GOOGLE_ANTIGRAVITY_CLIENT_ID=
# OPENCODE_GOOGLE_ANTIGRAVITY_CLIENT_SECRET=

# Diagnostics to stderr. Secrets are redacted.
OPENCODE_GOOGLE_DEBUG=0
